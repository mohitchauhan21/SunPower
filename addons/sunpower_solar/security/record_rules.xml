<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Technicians: only what is assigned to them. (Rules of other groups are OR-ed,
         so Sales/Support/Director, who have no rule here, still see everything.) -->
    <record id="rule_survey_technician" model="ir.rule">
        <field name="name">Technician: own surveys</field>
        <field name="model_id" ref="model_solar_site_survey"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
    </record>
    <record id="rule_survey_all" model="ir.rule">
        <field name="name">Office: all surveys</field>
        <field name="model_id" ref="model_solar_site_survey"/>
        <field name="groups" eval="[(4, ref('group_sales')), (4, ref('group_support'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_ticket_technician" model="ir.rule">
        <field name="name">Technician: own tickets</field>
        <field name="model_id" ref="model_solar_service_ticket"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_ticket_office" model="ir.rule">
        <field name="name">Office: all tickets</field>
        <field name="model_id" ref="model_solar_service_ticket"/>
        <field name="groups" eval="[(4, ref('group_sales')), (4, ref('group_support'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_ticket_portal" model="ir.rule">
        <field name="name">Customer: own tickets</field>
        <field name="model_id" ref="model_solar_service_ticket"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', user.commercial_partner_id.id)]</field>
    </record>

    <record id="rule_warranty_technician" model="ir.rule">
        <field name="name">Technician: warranties of own jobs</field>
        <field name="model_id" ref="model_solar_warranty"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('sale_order_id.order_line.task_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_warranty_office" model="ir.rule">
        <field name="name">Office: all warranties</field>
        <field name="model_id" ref="model_solar_warranty"/>
        <field name="groups" eval="[(4, ref('group_sales')), (4, ref('group_support')), (4, ref('group_warehouse'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_warranty_portal" model="ir.rule">
        <field name="name">Customer: own warranties</field>
        <field name="model_id" ref="model_solar_warranty"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', user.commercial_partner_id.id)]</field>
    </record>

    <record id="rule_order_technician" model="ir.rule">
        <field name="name">Technician: orders of own jobs</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('order_line.task_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_order_office" model="ir.rule">
        <field name="name">Warehouse/Support: all orders (read)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('group_warehouse')), (4, ref('group_support'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Technicians read only the serial numbers installed on their own jobs -->
    <record id="rule_lot_technician" model="ir.rule">
        <field name="name">Technician: serials of own jobs</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('warranty_ids.sale_order_id.order_line.task_id.user_ids', 'in', [user.id])]</field>
    </record>

    <!-- Office roles can READ every installation job (writing stays limited to
         jobs they follow, via the standard project rule) -->
    <record id="rule_task_office_read" model="ir.rule">
        <field name="name">Office: read all installation jobs</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[(4, ref('group_sales')), (4, ref('group_support')), (4, ref('group_warehouse'))]"/>
        <field name="domain_force">[('is_installation', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
