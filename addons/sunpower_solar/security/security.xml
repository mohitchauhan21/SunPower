<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SunPower roles. Every staff member gets exactly one; the Director has everything.
         Customers use the standard portal group. See README "Roles & permissions". -->
    <record id="module_category_sunpower" model="ir.module.category">
        <field name="name">SunPower</field>
        <field name="description">Role of the person in SunPower</field>
        <field name="sequence">1</field>
    </record>

    <record id="group_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_sunpower"/>
        <field name="comment">Installs and repairs. Sees only the jobs, surveys and tickets assigned to them. No prices, stock or money.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user')), (4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
    </record>

    <record id="group_warehouse" model="res.groups">
        <field name="name">Warehouse</field>
        <field name="category_id" ref="module_category_sunpower"/>
        <field name="comment">Packs and dispatches kits, scans serial numbers. Reads orders to pack them.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_support" model="res.groups">
        <field name="name">Support</field>
        <field name="category_id" ref="module_category_sunpower"/>
        <field name="comment">Handles complaints and repair tickets, looks up customers by phone or serial.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sales" model="res.groups">
        <field name="name">Sales</field>
        <field name="category_id" ref="module_category_sunpower"/>
        <field name="comment">Enquiries, surveys, quotes, orders, invoices and subsidy files. Never sees cost or profit.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('account.group_account_invoice')), (4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_director" model="res.groups">
        <field name="name">Director</field>
        <field name="category_id" ref="module_category_sunpower"/>
        <field name="comment">Everything: money, reports, dashboard, settings and users.</field>
        <field name="implied_ids" eval="[(4, ref('group_sales')), (4, ref('group_warehouse')), (4, ref('group_support')),
            (4, ref('sales_team.group_sale_manager')), (4, ref('stock.group_stock_manager')),
            (4, ref('account.group_account_manager')), (4, ref('project.group_project_manager')),
            (4, ref('hr_timesheet.group_timesheet_manager')), (4, ref('mrp.group_mrp_user')),
            (4, ref('base.group_system'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
