<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_solar" model="ir.ui.view">
        <field name="name">sale.order.form.solar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_warranties" type="object" class="oe_stat_button"
                        icon="fa-shield" invisible="warranty_count == 0">
                    <div class="o_stat_info">
                        <field name="warranty_count" class="o_stat_value"/>
                        <span class="o_stat_text">Warranties</span>
                    </div>
                </button>
                <button name="action_view_tickets" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="not is_solar_job or state != 'sale'">
                    <div class="o_stat_info">
                        <field name="ticket_count" class="o_stat_value"/>
                        <span class="o_stat_text">Tickets</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_solar_job" invisible="1"/>
                <field name="survey_id" invisible="not is_solar_job"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Solar Job" name="solar" invisible="not is_solar_job">
                    <group>
                        <group string="System">
                            <field name="solar_kw"/>
                            <field name="solar_system_type"/>
                            <field name="job_stage" widget="badge"/>
                            <field name="job_pending_steps"/>
                        </group>
                        <group string="Generation Estimate">
                            <field name="est_kwh_year"/>
                            <field name="est_savings_year"/>
                            <field name="est_payback_years"/>
                            <field name="est_source" class="text-muted"/>
                            <button name="action_compute_generation" type="object"
                                    string="Compute with PVGIS" icon="fa-sun-o"
                                    class="btn-secondary" colspan="2"/>
                        </group>
                    </group>
                    <group string="Job Profitability" invisible="state != 'sale'">
                        <group>
                            <field name="amount_untaxed" string="Contract Value"/>
                            <field name="job_material_cost"/>
                            <field name="job_labour_cost"/>
                            <field name="job_labour_hours"/>
                            <field name="job_repair_cost"/>
                        </group>
                        <group>
                            <field name="job_profit" class="fw-bold"
                                   decoration-danger="job_profit &lt; 0"
                                   decoration-success="job_profit &gt;= 0"/>
                            <field name="job_margin"/>
                            <field name="job_invoiced"/>
                            <field name="job_collected"/>
                            <button name="action_refresh_financials" type="object"
                                    string="Refresh" icon="fa-refresh" colspan="2"
                                    class="btn-link"/>
                        </group>
                    </group>
                    <field name="subsidy_ids" invisible="not subsidy_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="scheme"/>
                            <field name="amount_expected"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale_order_template_form_solar" model="ir.ui.view">
        <field name="name">sale.order.template.form.solar</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="after">
                <group>
                    <field name="solar_kw"/>
                    <field name="solar_system_type"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_solar_job_list" model="ir.ui.view">
        <field name="name">sale.order.solar.job.list</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list decoration-danger="job_profit &lt; 0" create="0">
                <field name="name"/>
                <field name="date_order" widget="date"/>
                <field name="partner_id"/>
                <field name="solar_kw"/>
                <field name="solar_system_type"/>
                <field name="amount_untaxed" string="Contract" sum="Total"/>
                <field name="job_material_cost" sum="Total"/>
                <field name="job_labour_cost" sum="Total"/>
                <field name="job_repair_cost" sum="Total" optional="show"/>
                <field name="job_profit" sum="Total"/>
                <field name="job_margin" avg="Average"/>
                <field name="job_collected" sum="Total" optional="show"/>
                <field name="job_stage" widget="badge"
                       decoration-success="job_stage == 'closed'"
                       decoration-warning="job_stage in ('confirmed', 'dispatched')"
                       decoration-info="job_stage == 'installed'"/>
                <field name="job_pending_steps"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_solar_job_pivot" model="ir.ui.view">
        <field name="name">sale.order.solar.job.pivot</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date_order" interval="month" type="row"/>
                <field name="solar_system_type" type="col"/>
                <field name="amount_untaxed" type="measure"/>
                <field name="job_profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_solar_job_search" model="ir.ui.view">
        <field name="name">sale.order.solar.job.search</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="loss" string="Loss-making" domain="[('job_profit', '&lt;', 0)]"/>
                <filter name="unfinished" string="Unfinished" domain="[('job_stage', '!=', 'closed')]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date_order', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_stage" string="Job Stage" context="{'group_by': 'job_stage'}"/>
                    <filter name="g_month" string="Month" context="{'group_by': 'date_order:month'}"/>
                    <filter name="g_type" string="System Type" context="{'group_by': 'solar_system_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_solar_jobs" model="ir.actions.act_window">
        <field name="name">Job Profitability</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('is_solar_job', '=', True), ('state', '=', 'sale')]</field>
        <field name="search_view_id" ref="view_solar_job_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_solar_job_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_solar_job_pivot')})]"/>
    </record>

    <record id="action_solar_quotations" model="ir.actions.act_window">
        <field name="name">Quotations &amp; Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_solar_job', '=', True)]</field>
    </record>
</odoo>
