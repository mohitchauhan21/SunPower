<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mobile-first form used by the crew on the roof -->
    <record id="view_installation_task_form" model="ir.ui.view">
        <field name="name">project.task.installation.form</field>
        <field name="model">project.task</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <form string="Installation Job">
                <header>
                    <button name="action_start_work" string="▶ Start Work" type="object"
                            class="btn-primary" invisible="installation_state != 'planned'"/>
                    <button name="action_finish_work" string="✔ Finish &amp; Hand Over" type="object"
                            class="btn-success" invisible="installation_state != 'in_progress'"/>
                    <field name="installation_state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success"
                            invisible="installation_state != 'done'"/>
                    <div class="oe_title">
                        <h2><field name="name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id" readonly="1"/>
                            <field name="partner_phone" widget="phone" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="installation_kw_planned" readonly="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="installation_date"/>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="site_start"/>
                            <field name="site_end"/>
                            <field name="site_hours" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Checklist">
                        <field name="chk_stands" readonly="installation_state == 'done'"/>
                        <field name="chk_panels" readonly="installation_state == 'done'"/>
                        <field name="chk_wiring" readonly="installation_state == 'done'"/>
                        <field name="chk_earthing" readonly="installation_state == 'done'"/>
                        <field name="chk_generation" readonly="installation_state == 'done'"/>
                    </group>
                    <group string="Test Results">
                        <field name="installation_kw_confirmed" readonly="installation_state == 'done'"/>
                        <field name="generation_reading_kw" readonly="installation_state == 'done'"/>
                        <field name="photo_check_result" invisible="not photo_check_result"/>
                    </group>
                    <separator string="Photos of the finished roof"/>
                    <field name="install_photo_ids" widget="many2many_binary"
                           readonly="installation_state == 'done'"/>
                    <separator string="Installed Equipment (serials &amp; warranty)"/>
                    <field name="installed_serials" nolabel="1" class="text-muted"/>
                    <separator string="Customer Acceptance"/>
                    <group>
                        <field name="signed_by" readonly="installation_state == 'done'"
                               placeholder="Homeowner name"/>
                        <field name="customer_signature" widget="signature"
                               readonly="installation_state == 'done'"/>
                        <field name="signed_on"/>
                    </group>
                    <field name="is_installation" invisible="1"/>
                    <field name="project_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_installation_task_calendar" model="ir.ui.view">
        <field name="name">project.task.installation.calendar</field>
        <field name="model">project.task</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <calendar date_start="installation_date" mode="week" color="installation_state"
                      event_open_popup="0" quick_create="0">
                <field name="partner_id"/>
                <field name="installation_kw_planned"/>
                <field name="user_ids" widget="many2many_avatar_user" filters="1"/>
                <field name="installation_state"/>
            </calendar>
        </field>
    </record>

    <record id="view_installation_task_list" model="ir.ui.view">
        <field name="name">project.task.installation.list</field>
        <field name="model">project.task</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="installation_date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="installation_kw_planned"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="site_hours" widget="float_time"/>
                <field name="installation_state" widget="badge"
                       decoration-success="installation_state == 'done'"
                       decoration-warning="installation_state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_installation_task_kanban" model="ir.ui.view">
        <field name="name">project.task.installation.kanban</field>
        <field name="model">project.task</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <kanban default_group_by="installation_state" create="0">
                <templates>
                    <t t-name="card">
                        <field name="partner_id" class="fw-bold"/>
                        <div><field name="installation_kw_planned"/> kW · <field name="installation_date" widget="date"/></div>
                        <field name="user_ids" widget="many2many_avatar_user"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_installation_jobs" model="ir.actions.act_window">
        <field name="name">Installation Jobs</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="domain">[('is_installation', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_installation_task_calendar')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_installation_task_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_installation_task_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_installation_task_form')})]"/>
    </record>

    <record id="action_my_installation_jobs" model="ir.actions.act_window">
        <field name="name">My Jobs Today</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('is_installation', '=', True), ('user_ids', 'in', uid), ('installation_state', '!=', 'done')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_installation_task_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_installation_task_form')})]"/>
    </record>

    <record id="project_task_form_solar" model="ir.ui.view">
        <field name="name">project.task.form.solar</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_installation" invisible="1"/>
                <button name="action_open_installation_form" type="object"
                        string="Open Installation Form" class="btn-primary"
                        invisible="not is_installation"/>
            </xpath>
        </field>
    </record>

    <!-- Technician hours & payable -->
    <record id="view_technician_hours_pivot" model="ir.ui.view">
        <field name="name">account.analytic.line.technician.pivot</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Technician Hours">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="unit_amount" type="measure" string="Hours"/>
                <field name="amount" type="measure" string="Cost (negative = payable)"/>
            </pivot>
        </field>
    </record>
    <record id="action_technician_hours" model="ir.actions.act_window">
        <field name="name">Technician Hours &amp; Pay</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('task_id.is_installation', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_technician_hours_pivot')})]"/>
    </record>
</odoo>
