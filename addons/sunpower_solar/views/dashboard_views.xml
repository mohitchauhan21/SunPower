<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_solar_dashboard" model="ir.actions.client">
        <field name="name">Director Dashboard</field>
        <field name="tag">sunpower_solar.dashboard</field>
    </record>

    <record id="view_solar_director_report_form" model="ir.ui.view">
        <field name="name">solar.director.report.form</field>
        <field name="model">solar.director.report</field>
        <field name="arch" type="xml">
            <form string="Share Report">
                <group>
                    <field name="period" widget="radio" options="{'horizontal': true}"/>
                    <field name="email_to" placeholder="investor@example.com"/>
                </group>
                <footer>
                    <button name="action_print" string="Download PDF" type="object" class="btn-primary"/>
                    <button name="action_send" string="Email Report" type="object"
                            class="btn-secondary" invisible="not email_to"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_solar_director_report" model="ir.actions.act_window">
        <field name="name">Share Report</field>
        <field name="res_model">solar.director.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_solar_enquiry_wizard_form" model="ir.ui.view">
        <field name="name">solar.enquiry.wizard.form</field>
        <field name="model">solar.enquiry.wizard</field>
        <field name="arch" type="xml">
            <form string="Log Enquiry">
                <group>
                    <field name="channel" widget="radio" options="{'horizontal': true}"/>
                    <field name="raw_message" placeholder="Paste the WhatsApp message or type call notes"/>
                    <field name="voice_note" filename="voice_filename"/>
                    <field name="voice_filename" invisible="1"/>
                </group>
                <div name="ai_buttons"/>
                <group>
                    <group>
                        <field name="intent" widget="radio"/>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="street"/>
                        <field name="city"/>
                    </group>
                    <group invisible="intent != 'new_enquiry'">
                        <field name="system_kw"/>
                        <field name="system_type"/>
                        <field name="subsidy"/>
                        <field name="monthly_bill"/>
                    </group>
                </group>
                <field name="summary" placeholder="Summary"/>
                <footer>
                    <button name="action_create" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_solar_enquiry_wizard" model="ir.actions.act_window">
        <field name="name">Log WhatsApp / Call</field>
        <field name="res_model">solar.enquiry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
