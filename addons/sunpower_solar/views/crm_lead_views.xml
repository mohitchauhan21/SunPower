<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_solar" model="ir.ui.view">
        <field name="name">crm.lead.form.solar</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- No quote before the roof survey is approved: hide the button entirely -->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">type == 'lead' or probability == 0 and not active or not approved_survey_id</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_schedule_survey" string="Schedule Roof Survey"
                        type="object" class="btn-primary"
                        invisible="type != 'opportunity' or survey_state not in ('none', 'rejected')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_surveys" type="object" class="oe_stat_button"
                        icon="fa-home" invisible="survey_count == 0">
                    <div class="o_stat_info">
                        <field name="survey_count" class="o_stat_value"/>
                        <span class="o_stat_text">Surveys</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="mb-2">
                    <field name="survey_state" widget="badge"
                           decoration-success="survey_state == 'approved'"
                           decoration-info="survey_state == 'scheduled'"
                           decoration-warning="survey_state in ('done', 'none')"
                           decoration-danger="survey_state == 'rejected'"/>
                    <field name="enquiry_channel" widget="badge" class="ms-2"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Solar Requirement" name="solar">
                    <group>
                        <group string="Requirement">
                            <field name="requested_kw"/>
                            <field name="system_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="subsidy_requested"/>
                            <field name="recommended_kw" invisible="not recommended_kw"/>
                            <field name="approved_survey_id" invisible="not approved_survey_id"/>
                        </group>
                        <group string="Phone Screening">
                            <field name="roof_area_sqft"/>
                            <field name="monthly_bill"/>
                            <field name="monthly_units"/>
                            <field name="grid_suitable"/>
                            <field name="discom"/>
                            <field name="consumer_no"/>
                            <field name="bill_attachment" filename="bill_filename"/>
                            <field name="bill_filename" invisible="1"/>
                            <field name="screening_ok" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="screening_ok or type != 'opportunity'">
                        Phone screening incomplete: roof area, monthly bill/units and a
                        suitable grid connection are needed before scheduling a survey.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_kanban_solar" model="ir.ui.view">
        <field name="name">crm.lead.kanban.solar</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <div class="small text-muted">
                    <field name="requested_kw"/> kW ·
                    <field name="survey_state"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_search_solar" model="ir.ui.view">
        <field name="name">crm.lead.search.solar</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <filter name="survey_pending" string="Survey Pending"
                        domain="[('survey_state', 'in', ('none', 'scheduled', 'done'))]"/>
                <filter name="survey_ok" string="Survey Approved"
                        domain="[('survey_state', '=', 'approved')]"/>
                <filter name="from_web" string="From Website"
                        domain="[('enquiry_channel', '=', 'web')]"/>
            </xpath>
        </field>
    </record>
</odoo>
