<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="solar_quote_page" name="Get a Solar Quote">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="py-5" style="background: linear-gradient(135deg,#fff7e0,#ffe39a);">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-5 mb-4">
                                <h1 class="display-5 fw-bold">Go solar with SunPower</h1>
                                <p class="lead">1 kW to 5 kW rooftop systems, On-Grid or with battery backup.
                                    Free roof survey, subsidy paperwork handled, 20-year panel warranty.</p>
                                <ul class="list-unstyled">
                                    <li>☀️ Up to ₹78,000 PM Surya Ghar subsidy</li>
                                    <li>🔧 Installed by our own trained crew</li>
                                    <li>🛡️ Every inverter &amp; battery tracked by serial number</li>
                                </ul>
                            </div>
                            <div class="col-lg-7">
                                <div class="card shadow-sm">
                                    <div class="card-body p-4">
                                        <h3 class="mb-3">Get a free quote</h3>
                                        <div t-if="error" class="alert alert-danger" t-out="error"/>
                                        <form action="/solar-quote/submit" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label">Full name *</label>
                                                    <input name="name" class="form-control" required="1"
                                                           t-att-value="values and values.get('name')"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Phone *</label>
                                                    <input name="phone" type="tel" class="form-control" required="1"
                                                           t-att-value="values and values.get('phone')"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Email</label>
                                                    <input name="email" type="email" class="form-control"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">City</label>
                                                    <input name="city" class="form-control"/>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label">Address</label>
                                                    <input name="street" class="form-control"/>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">System size</label>
                                                    <select name="system_kw" class="form-select">
                                                        <option value="">Not sure</option>
                                                        <option value="1">1 kW</option>
                                                        <option value="2">2 kW</option>
                                                        <option value="3" selected="1">3 kW</option>
                                                        <option value="4">4 kW</option>
                                                        <option value="5">5 kW</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Type</label>
                                                    <select name="system_type" class="form-select">
                                                        <option value="on_grid">On-Grid</option>
                                                        <option value="off_grid">Off-Grid (battery)</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Monthly bill (₹)</label>
                                                    <input name="monthly_bill" type="number" class="form-control"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Shadow-free roof area (sq ft)</label>
                                                    <input name="roof_area" type="number" class="form-control"/>
                                                </div>
                                                <div class="col-md-6 d-flex align-items-end">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="subsidy" id="subsidy" checked="1"/>
                                                        <label class="form-check-label" for="subsidy">I want the government subsidy</label>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label">Anything else?</label>
                                                    <textarea name="notes" class="form-control" rows="2"/>
                                                </div>
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-warning btn-lg w-100">Request my free quote</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="solar_quote_thanks" name="Solar Quote Thanks">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5 text-center">
                <h1 class="display-6">Thank you! ☀️</h1>
                <p class="lead">Your enquiry reference is <strong t-out="lead.id"/>.
                    Our solar advisor will call you within 2 working hours to discuss your roof and bill.</p>
                <a href="/" class="btn btn-outline-secondary">Back to home</a>
            </div>
        </t>
    </template>

    <record id="menu_solar_quote" model="website.menu">
        <field name="name">Get a Solar Quote</field>
        <field name="url">/solar-quote</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">20</field>
    </record>
</odoo>
