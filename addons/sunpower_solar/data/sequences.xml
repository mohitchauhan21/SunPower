<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_site_survey" model="ir.sequence">
        <field name="name">Site Survey</field>
        <field name="code">solar.site.survey</field>
        <field name="prefix">SRV/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_service_ticket" model="ir.sequence">
        <field name="name">Service Ticket</field>
        <field name="code">solar.service.ticket</field>
        <field name="prefix">TKT/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_subsidy" model="ir.sequence">
        <field name="name">Subsidy Application</field>
        <field name="code">solar.subsidy.application</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
