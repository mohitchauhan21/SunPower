<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_installation_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="task">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Solar Installation &amp; Commissioning Certificate</h2>
                        <p class="text-center text-muted">Job <t t-out="task.name"/> ·
                            Order <t t-out="task.sale_order_id.name"/></p>
                        <table class="table table-sm mt-4">
                            <tr><th>Customer</th><td t-out="task.partner_id.name"/></tr>
                            <tr><th>Site address</th><td t-out="task.partner_id.contact_address"/></tr>
                            <tr><th>System installed</th><td><t t-out="task.installation_kw_confirmed"/> kW
                                (<t t-out="dict(task.sale_order_id._fields['solar_system_type'].selection).get(task.sale_order_id.solar_system_type)"/>)</td></tr>
                            <tr><th>Generation at test</th><td><t t-out="task.generation_reading_kw"/> kW</td></tr>
                            <tr><th>Work started</th><td><span t-field="task.site_start"/></td></tr>
                            <tr><th>Work finished</th><td><span t-field="task.site_end"/></td></tr>
                            <tr><th>Crew</th><td t-out="', '.join(task.user_ids.mapped('name'))"/></tr>
                        </table>

                        <h5 class="mt-4">Installed equipment &amp; warranty</h5>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Equipment</th><th>Serial / Lot</th><th>Warranty from</th><th>Warranty until</th></tr></thead>
                            <tbody>
                                <tr t-foreach="task.sale_order_id.warranty_ids" t-as="w">
                                    <td t-out="w.product_id.display_name"/>
                                    <td t-out="w.serial"/>
                                    <td><span t-field="w.start_date"/></td>
                                    <td><span t-field="w.end_date"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h5 class="mt-4">Checklist</h5>
                        <ul>
                            <li><t t-out="'✔' if task.chk_stands else '✘'"/> Mounting stands fixed</li>
                            <li><t t-out="'✔' if task.chk_panels else '✘'"/> Panels laid &amp; clamped</li>
                            <li><t t-out="'✔' if task.chk_wiring else '✘'"/> DCDB/ACDB &amp; wiring connected</li>
                            <li><t t-out="'✔' if task.chk_earthing else '✘'"/> Earthing &amp; lightning arrester</li>
                            <li><t t-out="'✔' if task.chk_generation else '✘'"/> Power generation tested</li>
                        </ul>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Accepted by the customer:</p>
                                <img t-if="task.customer_signature"
                                     t-att-src="image_data_uri(task.customer_signature)"
                                     style="max-height: 90px;"/>
                                <p><strong t-out="task.signed_by"/><br/>
                                    <span t-field="task.signed_on"/></p>
                            </div>
                            <div class="col-6 text-end">
                                <p>For SunPower Solutions</p>
                                <p class="mt-5">Authorised signatory</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
