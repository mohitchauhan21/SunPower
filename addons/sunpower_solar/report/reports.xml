<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_installation_certificate" model="ir.actions.report">
        <field name="name">Installation Certificate</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sunpower_solar.report_installation_certificate</field>
        <field name="report_file">sunpower_solar.report_installation_certificate</field>
        <field name="print_report_name">'Installation-Certificate-%s' % object.partner_id.name</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_director" model="ir.actions.report">
        <field name="name">SunPower Performance Report</field>
        <field name="model">solar.director.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sunpower_solar.report_director</field>
        <field name="report_file">sunpower_solar.report_director</field>
        <field name="print_report_name">'SunPower-Report-%s' % object.period</field>
    </record>

    <!-- Generation estimate on the customer quote -->
    <template id="report_saleorder_solar" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div t-if="doc.is_solar_job and doc.est_kwh_year" class="mt-4 p-3"
                 style="border: 1px solid #f0b400; border-radius: 6px; background: #fffaf0;">
                <h5>Your solar system at a glance</h5>
                <t t-set="subsidy" t-value="doc.solar_system_type == 'on_grid' and doc.opportunity_id.subsidy_requested and doc.env['solar.subsidy.application']._expected_subsidy(doc.solar_kw) or 0"/>
                <table class="table table-sm mb-0">
                    <tr><td>System size</td><td><strong t-out="doc.solar_kw"/> kW
                        (<t t-out="dict(doc._fields['solar_system_type'].selection).get(doc.solar_system_type)"/>)</td></tr>
                    <tr><td>Estimated generation</td><td><strong t-out="'{:,.0f}'.format(doc.est_kwh_year)"/> kWh / year</td></tr>
                    <tr><td>Estimated savings</td><td><strong t-field="doc.est_savings_year"/> / year</td></tr>
                    <tr t-if="subsidy"><td>Govt. subsidy (PM Surya Ghar, paid to you by the government)</td>
                        <td><strong t-out="subsidy" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                    <tr t-if="subsidy"><td><strong>Your cost after subsidy</strong></td>
                        <td><strong t-out="doc.amount_total - subsidy" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                    <tr><td>Estimated payback</td><td><strong t-out="'%.1f' % ((doc.amount_total - subsidy) / doc.est_savings_year if doc.est_savings_year else doc.est_payback_years)"/> years</td></tr>
                </table>
                <small class="text-muted">Source: <t t-out="doc.est_source"/>. Subsidy, if eligible, further reduces your cost.</small>
            </div>
        </xpath>
    </template>
</odoo>
