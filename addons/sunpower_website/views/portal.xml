<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_solar" name="My Solar (customer portal)">
        <t t-call="website.layout">
            <div id="wrap" class="sp-site">
                <t t-call="sunpower_website.page_header">
                    <t t-set="title">My solar</t>
                    <t t-set="subtitle" t-value="'Welcome, %s. Track your installation, warranties and service requests.' % partner.name"/>
                    <t t-set="crumb">Customer portal</t>
                </t>

                <section class="sp-section pt-4">
                    <div class="container">
                        <div t-if="submitted == 'error'" class="alert alert-danger">Please describe the problem before submitting.</div>
                        <div t-elif="submitted" class="alert alert-success">Your complaint has been registered. A technician will be assigned shortly.</div>

                        <!-- INSTALLATIONS -->
                        <h3 class="sp-h3">Installation status</h3>
                        <div t-if="not jobs and not orders" class="sp-card sp-empty">
                            <p class="mb-2">No installation linked to your account yet.</p>
                            <a href="/solar/estimate" class="btn sp-btn-sun btn-sm">Get an estimate</a>
                        </div>
                        <div t-if="orders and not jobs" class="sp-card mb-3">
                            <t t-foreach="orders" t-as="o">
                                <div class="d-flex justify-content-between">
                                    <span>Order <strong t-out="o.name"/>. Confirmed, installation being scheduled.</span>
                                    <t t-call="sunpower_website.pill"><t t-set="label">Order confirmed</t><t t-set="tone">info</t></t>
                                </div>
                            </t>
                        </div>
                        <t t-foreach="jobs" t-as="job">
                            <t t-set="st" t-value="job.installation_state"/>
                            <t t-set="chk" t-value="[job.chk_stands, job.chk_panels, job.chk_wiring, job.chk_earthing, job.chk_generation]"/>
                            <div class="sp-card mb-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                    <div>
                                        <h5 class="mb-1" t-out="job.name"/>
                                        <div class="sp-muted">
                                            <t t-if="job.sale_order_id">Order <t t-out="job.sale_order_id.name"/> · </t>
                                            <t t-out="job.installation_kw_confirmed or job.installation_kw_planned"/> kW
                                            <t t-if="job.installation_date"> · Scheduled
                                                <span t-field="job.installation_date" t-options="{'widget': 'datetime', 'format': 'd MMM yyyy, HH:mm'}"/></t>
                                        </div>
                                    </div>
                                    <t t-call="sunpower_website.pill">
                                        <t t-set="label" t-value="dict(job._fields['installation_state'].selection).get(st)"/>
                                        <t t-set="tone" t-value="{'planned': 'info', 'in_progress': 'warn', 'done': 'ok'}.get(st)"/>
                                    </t>
                                </div>
                                <ol class="sp-track">
                                    <li class="done">Order confirmed</li>
                                    <li t-att-class="'done' if job.installation_date else ''">Installation scheduled</li>
                                    <li t-att-class="'done' if st in ('in_progress', 'done') else ''">Crew on site</li>
                                    <li t-att-class="'done' if st == 'done' else ''">Tested &amp; handed over</li>
                                </ol>
                                <div class="sp-muted small">Checklist: <t t-out="len([c for c in chk if c])"/> / 5 complete</div>
                                <div t-if="st == 'done' and job.installed_serials" class="mt-2">
                                    <details><summary>Installed equipment &amp; warranties</summary>
                                        <pre class="sp-pre" t-out="job.installed_serials"/></details>
                                </div>
                            </div>
                        </t>

                        <div class="row g-4 mt-1">
                            <!-- TICKETS -->
                            <div class="col-lg-7" id="tickets">
                                <h3 class="sp-h3">My service requests</h3>
                                <div t-if="not tickets" class="sp-card sp-empty"><p class="mb-0">No complaints raised. 🎉</p></div>
                                <div t-else="" class="sp-card p-0">
                                    <table class="table sp-table mb-0">
                                        <thead><tr><th>Ticket</th><th>Equipment</th><th>Raised</th><th>Status</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="tickets" t-as="tk">
                                                <td><a t-attf-href="/my/solar-ticket/#{tk.id}?access_token=#{tk.access_token}" t-out="tk.name"/></td>
                                                <td><t t-out="tk.product_id.display_name or '—'"/>
                                                    <div t-if="tk.under_warranty" class="small text-success">Under warranty</div></td>
                                                <td><span t-field="tk.reported_on" t-options="{'widget': 'date'}"/></td>
                                                <td><t t-call="sunpower_website.pill">
                                                    <t t-set="label" t-value="dict(tk._fields['stage'].selection).get(tk.stage)"/>
                                                    <t t-set="tone" t-value="{'new': 'info', 'diagnosed': 'info', 'repair': 'warn', 'awaiting': 'warn', 'closed': 'ok', 'cancel': 'muted'}.get(tk.stage)"/>
                                                </t></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <h3 class="sp-h3 mt-4">My warranties</h3>
                                <div t-if="not warranties" class="sp-card sp-empty"><p class="mb-0">Warranties appear here once your system is installed.</p></div>
                                <div t-else="" class="sp-card p-0">
                                    <table class="table sp-table mb-0">
                                        <thead><tr><th>Equipment</th><th>Serial</th><th>Valid until</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="warranties" t-as="w">
                                                <td t-out="w.product_id.display_name"/>
                                                <td><code t-out="w.serial"/></td>
                                                <td><span t-field="w.end_date"/>
                                                    <t t-call="sunpower_website.pill">
                                                        <t t-set="label" t-value="'Active' if w.state == 'active' else 'Expired'"/>
                                                        <t t-set="tone" t-value="'ok' if w.state == 'active' else 'muted'"/>
                                                    </t></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- NEW COMPLAINT -->
                            <div class="col-lg-5" id="complaint">
                                <h3 class="sp-h3">Raise a complaint</h3>
                                <div class="sp-card">
                                    <form action="/my/solar/complaint" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <label class="form-label">Which equipment?</label>
                                        <select name="warranty_id" class="form-select mb-3">
                                            <option value="">Not sure / whole system</option>
                                            <option t-foreach="warranties" t-as="w" t-att-value="w.id">
                                                <t t-out="w.product_id.display_name"/> (<t t-out="w.serial"/>)</option>
                                        </select>
                                        <label class="form-label">Error code on inverter display (if any)</label>
                                        <input name="fault_code" class="form-control mb-3" placeholder="e.g. E021"/>
                                        <label class="form-label">What's the problem? *</label>
                                        <textarea name="description" rows="4" class="form-control mb-3" required="1"
                                                  placeholder="e.g. Inverter shows a red light since yesterday, no generation in the app."/>
                                        <button type="submit" class="btn sp-btn-sun w-100">Submit complaint</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
