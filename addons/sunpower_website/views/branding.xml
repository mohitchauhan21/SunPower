<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website name (logo comes from the company logo set by sunpower_solar) -->
    <!-- website.default_website is noupdate, so write it explicitly -->
    <function model="website" name="write">
        <value eval="[ref('website.default_website')]"/>
        <value eval="{'name': 'SunPower Solutions'}"/>
    </function>

    <!-- Header logo = company logo (set by sunpower_solar) instead of "YourLogo" -->
    <function model="website" name="_sp_sync_logo_from_company"/>

    <!-- Hide the header search box: frees room so all menu items fit on laptop width -->
    <function model="ir.ui.view" name="write">
        <value eval="[ref('website.header_search_box')]"/>
        <value eval="{'active': False}"/>
    </function>

    <!-- Header CTA: "Contact Us" -> "Get a Solar Quote" (/solar-quote, owned by sunpower_solar).
         Keeps the oe_unremovable class so the Large/Stretched variants still apply. -->
    <template id="sp_header_cta" inherit_id="website.header_call_to_action" name="SunPower Header CTA">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a href="/solar-quote" class="oe_unremovable btn btn-primary btn_cta sp-header-cta">Get a Solar Quote</a>
        </xpath>
    </template>

    <!-- Header phone (default text element variant) -->
    <template id="sp_header_phone" inherit_id="website.header_text_element" name="SunPower Header Phone">
        <xpath expr="//t[@t-else='']/div" position="replace">
            <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                <a href="tel:+917940005000" class="nav-link o_nav-link_secondary p-2">
                    <i class="fa fa-1x fa-fw fa-phone me-1"/>
                    <span class="o_force_ltr"><small>+91 79 4000 5000</small></span>
                </a>
            </div>
        </xpath>
    </template>

    <!-- Footer -->
    <template id="sp_footer" inherit_id="website.footer_custom" name="SunPower Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo sp-footer" t-ignore="true" t-if="not no_footer">
                <section class="pt40 pb16">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-lg-5">
                                <h5 class="mb-3">☀ SunPower Solutions</h5>
                                <p>Rooftop solar for homes and small businesses in Ahmedabad: 1 kW to 5 kW systems,
                                    On-Grid or Off-Grid with battery backup. Free site survey, PM Surya Ghar subsidy
                                    paperwork, installation by our own crew and serial-tracked warranties.</p>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <h5 class="mb-3">Solar</h5>
                                <ul class="list-unstyled sp-footer-links">
                                    <li><a href="/solar-quote">Get a Solar Quote</a></li>
                                    <li><a href="/solar/estimate">Savings Estimate</a></li>
                                    <li><a href="/my/solar">My Solar</a></li>
                                </ul>
                            </div>
                            <div class="col-sm-6 col-lg-4">
                                <h5 class="mb-3">Contact</h5>
                                <ul class="list-unstyled sp-footer-links">
                                    <li><i class="fa fa-phone fa-fw me-2"/><a href="tel:+917940005000" class="o_force_ltr">+91 79 4000 5000</a></li>
                                    <li><i class="fa fa-envelope fa-fw me-2"/><a href="mailto:hello@sunpower.example">hello@sunpower.example</a></li>
                                    <li class="d-flex"><i class="fa fa-map-marker fa-fw me-2 mt-1"/>
                                        <span>12 Solar Park Road, SG Highway,<br/>Ahmedabad 380054</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Copyright line -->
    <template id="sp_copyright" inherit_id="website.footer_copyright_company_name" name="SunPower Copyright">
        <xpath expr="//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2">© SunPower Solutions</span>
        </xpath>
    </template>
</odoo>
