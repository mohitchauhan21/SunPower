<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sign-in: Google only (the Director switches it on in Settings > Integrations
         once a Client ID is entered). The built-in Odoo.com provider is switched off
         on every update, because its own record is protected (noupdate). -->
    <function model="auth.oauth.provider" name="write">
        <value eval="[ref('auth_oauth.provider_openerp')]"/>
        <value eval="{'enabled': False}"/>
    </function>
</odoo>
