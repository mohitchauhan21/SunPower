# Copy this file to .env and fill in the values. Never commit .env.

# Local PostgreSQL (no Docker). Replace YOUR_PASSWORD with your postgres user's password.
# The databases are created automatically by `pnpm db:setup`.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sunpower_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sunpower_test?schema=public"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"

# File storage: "local" (disk, dev) or "s3" (later)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Notifications: "console" (dev) or a real provider later
NOTIFICATION_PROVIDER="console"

# Password used for every seeded demo user (dev only)
SEED_USER_PASSWORD="SunPower@123"
