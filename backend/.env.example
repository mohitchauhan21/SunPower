# Copy this file to backend/.env and fill in the values (backend/.env is never committed).
# The Director can also enter these in the website: Settings > Integrations.

# Google sign-in ("Continue with Google")
# 1. https://console.cloud.google.com/apis/credentials > Create credentials > OAuth client ID > Web application
# 2. Authorised JavaScript origin:   http://localhost:5173
#    Authorised redirect URI:        http://localhost:5173/api/auth/google/callback
#    (use your real website address instead of localhost:5173 when the site is online)
# 3. Paste the two values below and restart the back end.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
